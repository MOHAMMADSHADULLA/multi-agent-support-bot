# Which LLM powers the Support and Escalation agents: openai | gemini | mock
LLM_PROVIDER=mock

# Required if LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Required if LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# RAG tuning
RAG_TOP_K=3
RAG_SIMILARITY_THRESHOLD=0.08
